{
  "general": {
    "description": "通用设置",
    "type": "object",
    "hint": "解析触发方式与消息发送方式。",
    "items": {
      "is_auto_parse": {
        "description": "自动解析链接",
        "type": "bool",
        "default": true,
        "hint": "关闭后需手动发送「链接解析 + 链接」。"
      },
      "is_auto_pack": {
        "description": "打包为消息集合",
        "type": "bool",
        "default": true,
        "hint": "图集的文本与图片会拆成平级节点；微信平台请关闭。"
      },
      "enable_group": {
        "description": "群聊启用",
        "type": "bool",
        "default": true,
        "hint": "关闭后不在群聊中解析链接。"
      },
      "enable_private": {
        "description": "私聊启用",
        "type": "bool",
        "default": true,
        "hint": "关闭后不在私聊中解析链接。"
      },
      "block_after_parse": {
        "description": "解析后阻断 LLM",
        "type": "bool",
        "default": true,
        "hint": "解析成功后不再把这条消息交给大模型，避免解析完又多一条 AI 回复。"
      },
      "enable_conversation_history": {
        "description": "写入 LLM 会话",
        "type": "bool",
        "default": false,
        "hint": "开启后把解析结果写入当前会话，之后问 bot「刚才发的什么视频」它才答得上来。"
      },
      "conversation_history_mode": {
        "description": "会话记录内容",
        "type": "string",
        "default": "text_only",
        "options": [
          "text_only",
          "text_and_images"
        ],
        "labels": [
          "仅保存文字",
          "保存文字和图片"
        ],
        "hint": "仅在开启写入 LLM 会话后生效；图片模式会占用更多存储空间与模型上下文。"
      },
      "dedupe_seconds": {
        "description": "防抖秒数",
        "type": "int",
        "default": 300,
        "hint": "同一群 / 同一会话内，相同链接在该秒数内不重复解析；填 0 表示不限制。"
      },
      "node_sender_name": {
        "description": "消息集合发送者名字",
        "type": "string",
        "default": "",
        "hint": "留空时自动使用机器人昵称 / 群名片（QQ 平台）。"
      }
    }
  },
  "platform_switches": {
    "description": "启用平台",
    "type": "object",
    "hint": "按需开启或关闭各平台的链接解析。",
    "items": {
      "douyin": {
        "description": "抖音",
        "type": "bool",
        "default": true,
        "hint": "解析视频与图集。"
      },
      "bilibili": {
        "description": "Bilibili",
        "type": "bool",
        "default": true,
        "hint": "解析视频、动态、专栏、直播、番剧。"
      },
      "redbook": {
        "description": "小红书",
        "type": "bool",
        "default": true,
        "hint": "解析图文与视频笔记。"
      },
      "tieba": {
        "description": "贴吧",
        "type": "bool",
        "default": true,
        "hint": "解析帖子正文、图片与视频。"
      },
      "weibo": {
        "description": "微博",
        "type": "bool",
        "default": true,
        "hint": "解析微博正文、图片与视频。"
      },
      "wechat": {
        "description": "微信",
        "type": "bool",
        "default": true,
        "hint": "解析公众号文章。"
      },
      "xiaoheihe": {
        "description": "小黑盒",
        "type": "bool",
        "default": true,
        "hint": "解析社区帖子。"
      },
      "zhihu": {
        "description": "知乎",
        "type": "bool",
        "default": true,
        "hint": "解析问题、回答、专栏文章与想法。"
      }
    }
  },
